# Claude (required for real parsing/judging)
ANTHROPIC_BASE_URL=
# If your proxy/gateway expects "Authorization: Bearer", set this instead of ANTHROPIC_API_KEY
# ANTHROPIC_AUTH_TOKEN=
# Optional: Anthropic-compatible proxy base URL, e.g. https://proxy.example.com
ANTHROPIC_BASE_URL=

# PayPal sandbox app credentials (https://developer.paypal.com/dashboard/applications/sandbox)
# Leave empty to run in MOCK mode (fake escrow, great for offline demos)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

BASE_URL=http://localhost:3000
PORT=3000
